datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

enum Role {
  SUPER_ADMIN
  EDITOR
  VIEWER
  CONTRIBUTOR
}

enum CaseStatus {
  PELAPORAN
  PENYIDIKAN
  PENUNTUTAN
  PERSIDANGAN
  PUTUSAN
}

enum StageStatus {
  PENDING
  AKTIF
  SELESAI
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SourceType {
  OFFICIAL
  COURT
  MEDIA
  OTHER
}

enum CorrectionStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum NotificationType {
  STATUS_CHANGE
  STAGE_UPDATE
  ARTICLE_PUBLISHED
  CONTRIBUTION_REVIEWED
  EDITORIAL_REMINDER
}

model User {
  id                    String              @id @default(uuid())
  email                 String              @unique
  passwordHash          String
  name                  String
  role                  Role                @default(CONTRIBUTOR)
  bannedAt              DateTime?
  emailNotifications    Boolean             @default(true)
  // Account lockout after repeated failed sign-ins
  failedLogins          Int                 @default(0)
  lockedUntil           DateTime?
  // Two-factor sign-in (TOTP). The secret is AES-GCM encrypted; recovery codes are SHA-256 hashes.
  totpSecret            String?
  totpEnabledAt         DateTime?
  totpLastStep          Int?
  recoveryCodes         String[]            @default([])
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  stagesCreated         CaseStage[]         @relation("StageCreator")
  articlesCreated       Article[]           @relation("ArticleAuthor")
  contributions         CaseContribution[]  @relation("Contributor")
  reviewedContributions CaseContribution[]  @relation("Reviewer")
  verifiedSources       Source[]            @relation("SourceVerifier")
  handledCorrections    CorrectionRequest[] @relation("CorrectionHandler")
  activityLogs          ActivityLog[]
  revisions             CaseRevision[]
  refreshTokens         RefreshToken[]
  follows               Follow[]
  notifications         Notification[]

  @@map("users")
}

/// Opaque refresh tokens (only the SHA-256 hash is stored). Rotated on every use;
/// reuse of a revoked token revokes the whole family.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  color     String   @default("#1a56db")
  icon      String   @default("scale")
  cases     Case[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Defendant {
  id          String   @id @default(uuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  name        String
  /// slugify(name). Not unique: the same person can appear in several cases.
  slug        String
  role        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([caseId])
  @@index([slug])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "defendants_name_trgm_idx")
  @@map("defendants")
}

model Case {
  id             String              @id @default(uuid())
  slug           String              @unique
  caseNumber     String              @unique
  title          String
  summary        String?
  description    String              @db.Text
  categoryId     String
  category       Category            @relation(fields: [categoryId], references: [id])
  currentStatus  CaseStatus          @default(PELAPORAN)
  institution    String?
  court          String?
  /// Link to the SIPP "Detil Perkara" page the editors import from.
  sippUrl        String?
  region         String?
  filedAt        DateTime?
  lastActivityAt DateTime            @default(now())
  isActive       Boolean             @default(true)
  defendants     Defendant[]
  stages         CaseStage[]
  contributions  CaseContribution[]
  sources        Source[]
  revisions      CaseRevision[]
  follows        Follow[]
  corrections    CorrectionRequest[]
  notifications  Notification[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([isActive, currentStatus])
  @@index([categoryId])
  @@index([lastActivityAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "cases_title_trgm_idx")
  @@index([caseNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "cases_case_number_trgm_idx")
  @@map("cases")
}

model CaseStage {
  id          String      @id @default(uuid())
  caseId      String
  case        Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stageType   CaseStatus
  status      StageStatus @default(PENDING)
  title       String?
  summary     String?     @db.Text
  startedAt   DateTime    @default(now())
  endedAt     DateTime?
  /// Estimated/statutory deadline for this stage (e.g. masa penahanan, jadwal sidang).
  dueAt       DateTime?
  article     Article?    @relation("StageArticle")
  sources     Source[]
  createdById String
  createdBy   User        @relation("StageCreator", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([caseId, startedAt])
  @@map("case_stages")
}

model Article {
  id          String    @id @default(uuid())
  title       String
  content     String    @db.Text
  stageId     String    @unique
  stage       CaseStage @relation("StageArticle", fields: [stageId], references: [id], onDelete: Cascade)
  publishedAt DateTime  @default(now())
  authorId    String
  author      User      @relation("ArticleAuthor", fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("articles")
}

model Source {
  id           String     @id @default(uuid())
  caseId       String
  case         Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stageId      String?
  stage        CaseStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  title        String
  url          String
  publisher    String?
  type         SourceType @default(MEDIA)
  publishedAt  DateTime?
  isVerified   Boolean    @default(false)
  verifiedById String?
  verifiedBy   User?      @relation("SourceVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([caseId])
  @@index([stageId])
  @@map("sources")
}

/// Public, append-only history of what changed on a case and why.
model CaseRevision {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  summary   String
  reason    String?  @db.Text
  changes   Json?
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
  @@map("case_revisions")
}

model CaseContribution {
  id              String             @id @default(uuid())
  caseId          String
  case            Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId          String
  user            User               @relation("Contributor", fields: [userId], references: [id], onDelete: Cascade)
  description     String             @db.Text
  proposedStage   CaseStatus?
  status          ContributionStatus @default(PENDING)
  proofLinks      Json               @default("[]")
  proofFiles      Json               @default("[]")
  reviewedById    String?
  reviewedBy      User?              @relation("Reviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?            @db.Text
  appliedStageId  String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@map("case_contributions")
}

model Follow {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, caseId])
  @@index([caseId])
  @@map("follows")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId    String?
  case      Case?            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

/// Hak jawab / permintaan koreksi dari publik atau pihak terkait.
model CorrectionRequest {
  id          String           @id @default(uuid())
  caseId      String
  case        Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  name        String
  email       String
  relation    String
  message     String           @db.Text
  status      CorrectionStatus @default(OPEN)
  response    String?          @db.Text
  handledById String?
  handledBy   User?            @relation("CorrectionHandler", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt   DateTime?
  createdAt   DateTime         @default(now())

  @@index([status, createdAt])
  @@map("correction_requests")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("activity_logs")
}

/// One row per (job, day) so scheduled jobs run at most once a day across instances.
model JobRun {
  id        String   @id @default(uuid())
  name      String
  runDate   String
  createdAt DateTime @default(now())

  @@unique([name, runDate])
  @@map("job_runs")
}
