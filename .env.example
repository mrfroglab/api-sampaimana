# --- wajib ---
NODE_ENV=development
DATABASE_URL=postgresql://sm:sm@127.0.0.1:55432/sampaimana?schema=public
# Minimal 32 karakter acak: openssl rand -hex 32
JWT_SECRET=

# --- opsional ---
PORT=5000
# Asal (origin) frontend, dipisah koma. Wajib di production. "*" ditolak.
CORS_ORIGIN=http://localhost:5173
# URL publik situs, dipakai untuk tautan di email notifikasi.
PUBLIC_URL=http://localhost:5173
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# Folder privat untuk file bukti kontribusi.
UPLOAD_DIR=./uploads
# Jumlah proxy di depan API (Caddy = 1).
TRUST_PROXY=1
# Kosongkan untuk mematikan email; notifikasi di aplikasi tetap jalan.
SMTP_URL=
MAIL_FROM="Sampai Mana <no-reply@hallojanu.me>"

# --- seed (npm run seed) ---
SEED_ADMIN_EMAIL=
# Minimal 12 karakter.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Redaksi
SEED_DEMO=false
