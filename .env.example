# --- wajib ---
NODE_ENV=development
DATABASE_URL=postgresql://sm:sm@127.0.0.1:55432/sampaimana?schema=public
# Minimal 32 karakter acak: openssl rand -hex 32
JWT_SECRET=

# --- opsional ---
PORT=5000
# Asal (origin) frontend, dipisah koma. Wajib di production. "*" ditolak.
CORS_ORIGIN=http://localhost:5173
# URL publik situs, dipakai untuk tautan di email notifikasi.
PUBLIC_URL=http://localhost:5173
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# Folder privat untuk file bukti kontribusi.
UPLOAD_DIR=./uploads
# Jumlah proxy di depan API (Caddy = 1).
TRUST_PROXY=1
# Pengingat redaksi harian (setelah 07:00 WIB; notifikasi + email). Default: aktif hanya di production.
REMINDERS_ENABLED=
# Kasus tanpa pembaruan selama ini (hari) dianggap "menggantung" di /api/admin/attention.
STALE_DAYS=30
# --- keamanan akun ---
# "false" = tutup pendaftaran publik (akun hanya dibuat admin).
REGISTRATION_OPEN=true
# Cloudflare Turnstile di form daftar. Isi keduanya untuk mengaktifkan.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Tolak kata sandi yang pernah bocor (Have I Been Pwned, hanya 5 karakter awal hash yang dikirim). Default aktif kecuali saat test.
PWNED_CHECK=
# Akun dikunci sementara setelah sekian kali gagal masuk.
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=15

# Kosongkan untuk mematikan email; notifikasi di aplikasi tetap jalan.
SMTP_URL=
MAIL_FROM="Sampai Mana <no-reply@hallojanu.me>"

# --- seed (npm run seed) ---
SEED_ADMIN_EMAIL=
# Minimal 12 karakter.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Redaksi
SEED_DEMO=false
